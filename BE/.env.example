# ไฟล์ตัวอย่าง: คัดลอกเป็นไฟล์ชื่อ .env (อยู่ในโฟลเดอร์ BE) แล้วแก้บรรทัด LLM_API_KEY
# .env ถูก git ignore ไว้แล้ว — ห้าม commit key และห้ามวาง key ลงแชต AI

# สร้าง key ที่ https://aistudio.google.com/apikey
LLM_API_KEY=วางคีย์ของคุณตรงนี้
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# ชื่อโมเดลเปลี่ยนบ่อย ถ้าใช้ไม่ได้หรือโดน 429 บ่อย ให้แจ้งผู้สอน
LLM_MODEL=gemini-3.5-flash-lite

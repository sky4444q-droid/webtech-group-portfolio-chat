# ไฟล์ตัวอย่าง: คัดลอกเป็นไฟล์ชื่อ .env (อยู่ในโฟลเดอร์ BE) แล้วแก้ค่าด้านล่าง
# .env ถูก git ignore ไว้แล้ว — ห้าม commit key และห้ามวาง key ลงแชต AI

# สร้าง key ที่ https://aistudio.google.com/apikey
LLM_API_KEY=วางคีย์ของคุณตรงนี้
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# ชื่อโมเดลเปลี่ยนบ่อย ถ้าใช้ไม่ได้หรือโดน 429 บ่อย ให้แจ้งผู้สอน
LLM_MODEL=gemini-3.5-flash-lite

# PostgreSQL (Render: ใช้ External Database URL / Neon: Connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/chatdb

# โดเมนหน้าเว็บที่อนุญาตให้เรียก API (คั่นหลายโดเมนด้วยจุลภาค) เช่น https://your-web.onrender.com
CORS_ORIGIN=http://localhost:5173

# --- ตอนพัฒนาบนเครื่อง (npm run dev) ---
# ปล่อย VITE_API_URL ว่างไว้ แล้วเลือกว่าจะให้ Vite ส่งต่อไปหลังบ้านตัวไหน
#   รันหลังบ้านเองบนเครื่อง: ไม่ต้องตั้ง (ค่าเริ่มต้น http://localhost:3000)
#   ใช้หลังบ้านบน Render (ไม่ต้องมีคีย์/ฐานข้อมูล): ตั้งเป็นบรรทัดล่าง
VITE_PROXY_TARGET=https://webtech-chat-api.onrender.com

# --- ตอน deploy (Render Static Site) ---
# ตั้งเป็น URL ของ Backend เช่น https://webtech-chat-api.onrender.com
VITE_API_URL=
